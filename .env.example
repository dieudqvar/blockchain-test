# Redis
REDIS_URL=redis://:password@host:port

# Firebase Cloud Messaging
FCM_PROJECT_ID=your-firebase-project-id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# OneSignal (optional, alternative to FCM)
ONESIGNAL_REST_API_KEY=
ONESIGNAL_APP_ID=

# ZRO - Shared pagination config
# Set ZRO_FROM_BLOCK to the contract deployment block to skip empty ranges
ZRO_FROM_BLOCK=0
ZRO_BATCH_SIZE=2000

# ZRO - Total Claimed Job
ZRO_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
ZRO_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS
ZRO_CLAIMED_EVENT_TOPIC=0xYOUR_EVENT_TOPIC

# ZRO - Recipients Job (add RPC for each chain you want to scan)
ZRO_ETH_RPC=https://mainnet.infura.io/v3/YOUR_KEY
ZRO_ARB_RPC=https://arb1.arbitrum.io/rpc
ZRO_OP_RPC=https://mainnet.optimism.io
ZRO_BASE_RPC=https://mainnet.base.org
ZRO_POLYGON_RPC=https://polygon-rpc.com
ZRO_BSC_RPC=https://bsc-dataseed.binance.org
ZRO_AVAX_RPC=https://api.avax.network/ext/bc/C/rpc
